with "indexed_records.gpr";
project Records_Bench_Memory is
   for Languages use ("Ada");
   for Source_Dirs use ("src");
   for Source_Files use ("records_bench_memory.adb");
   for Main use ("records_bench_memory.adb");
   for Object_Dir use "obj/bench_memory";
   for Exec_Dir use "bin";
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-O2", "-gnata");
   end Compiler;
end Records_Bench_Memory;
