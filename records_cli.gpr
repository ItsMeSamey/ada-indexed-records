with "indexed_records.gpr";
project Records_CLI is
   for Languages use ("Ada");
   for Source_Dirs use ("src");
   for Source_Files use ("records_cli.adb");
   for Main use ("records_cli.adb");
   for Object_Dir use "obj/cli";
   for Exec_Dir use "bin";
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-O2", "-gnata");
   end Compiler;
end Records_CLI;
